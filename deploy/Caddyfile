# HTTPS in front of the site: Caddy gets and renews the certificate for SITE_DOMAIN and compresses
# responses. Point the domain's DNS at this server first.
# 正式网址（myfnb/go-live-checklist.md 第 2、6 步，myfnb/DIFFERENCES.md「域名转址」）：www 是站；根域转到 www 首页，试运行用的 new 原路转到 www。
www.myfnbguide.com {
	encode zstd gzip

	# 旧站（静态参考书）的网址转到首页。名单取自旧站 sitemap.xml（10/17，155 个地址）里新站没有的几组路径；
	# /about、/sources 新站有同名页面，保留新站的。名单以外的路径不动，新站真正的 404 照常是 404。
	@oldsite path /appendix /appendix/* /contents /contents/* /handbook /handbook/* /map /map/* /public/* /quick-start /quick-start/* /resources /resources/* /start /start/* /support /support/* /tools /tools/* /updates /updates/*
	redir @oldsite / permanent

	# 访问计数（myfnb/HANDOFF.md §2.4）：只记时间、路径、状态码和“是不是机器人”，不记 IP、请求头（含 cookie 和浏览器标识）、
	# 查询串，所以认不出是谁。机器人由浏览器标识判断，只留判断结果。myfnb/visits.sh 按天按类统计。
	@bot header_regexp ua User-Agent (?i)bot|crawl|spider|slurp|scrape|headless|curl|wget|python|go-http|java/|preview
	log_append @bot bot true
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>tls delete
			request>uri regexp \?.* ""
			resp_headers delete
		}
	}

	reverse_proxy web:3000
}

myfnbguide.com {
	redir https://www.myfnbguide.com/ permanent
}

new.myfnbguide.com {
	redir https://www.myfnbguide.com{uri} permanent
}
